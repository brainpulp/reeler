# Copy to .env and fill in. The .env file is gitignored — secrets never commit.

# Path to a Netscape-format cookies.txt exported from your browser for
# instagram.com (e.g. via the "Get cookies.txt LOCALLY" extension), captured
# while logged into your account.
REELER_IG_COOKIE_FILE=/absolute/path/to/instagram_cookies.txt

# Your Instagram handle (whose Saved collection to read).
REELER_IG_USERNAME=your_handle

# Optional: override where downloaded videos + the SQLite db live.
# REELER_DATA_DIR=/absolute/path/to/data
